{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/orders-admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/google-merchant-feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/order-status",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shipping",
      "destination": "/shipping.html"
    },
    {
      "source": "/returns",
      "destination": "/returns.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/image-credits",
      "destination": "/image-credits.html"
    },
    {
      "source": "/orders-admin",
      "destination": "/orders-admin.html"
    },
    {
      "source": "/products/:slug",
      "destination": "/products/:slug.html"
    },
    {
      "source": "/best-travel-accessories",
      "destination": "/best-travel-accessories.html"
    },
    {
      "source": "/disclosure",
      "destination": "/disclosure.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    },
    {
      "source": "/order-status",
      "destination": "/order-status.html"
    }
  ],
  "redirects": [
    {
      "source": "/products/obsidian-minimalist-chronograph",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/caramel-bronze-sculptural-desk-lamp",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/studio-anc-wireless-headphones",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/smoked-amber-glass-aroma-diffuser",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/magnetic-magsafe-walnut-desk-dock",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/hanging-toiletry-bag",
      "destination": "/#amazon-picks",
      "permanent": true
    },
    {
      "source": "/products/travel-plug-adapter",
      "destination": "/guides/universal-travel-adapter-guide",
      "permanent": true
    },
    {
      "source": "/products/foldable-travel-duffel",
      "destination": "/#travel-essentials",
      "permanent": true
    },
    {
      "source": "/products/travel-shoe-bags",
      "destination": "/#packing",
      "permanent": true
    },
    {
      "source": "/products/holder-case-for-airtag",
      "destination": "/#amazon-picks",
      "permanent": true
    },
    {
      "source": "/products/silicone-travel-bottles",
      "destination": "/#travel-essentials",
      "permanent": true
    }
  ]
}
